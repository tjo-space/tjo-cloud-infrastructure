[NetDev]
Name=wg0
Kind=wireguard
Description=wg0 - Wireguard Tunnel

[WireGuard]
ListenPort=51820
PrivateKeyFile=/etc/systemd/network/wg.private_key
RouteTable=off

{% for peer in cfg.peers %}
# Host: {{ peer.name }}
[WireGuardPeer]
PublicKey={{ peer.wireguard_public_key }}
PresharedKey={{ cfg.wireguard_pre_shared_key }}
AllowedIPs=fe80:fd76:6a6f:70::{{peer.id}}/64, {{ peer.wireguard_address }}
{% endfor %}
