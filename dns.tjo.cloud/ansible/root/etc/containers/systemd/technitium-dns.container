[Unit]
Description=Technitium DNS Server

[Container]
Image=docker.io/technitium/dns-server:15.6.2@sha256:eb48ac5c135f4ab936b536f74f853d53e15ab39ef37fdbc9598a089b90d9f245
Environment=DNS_SERVER_DOMAIN=dns.tjo.cloud
Environment=DNS_SERVER_PREFER_IPV6=true
Network=main.network
# WebUI
PublishPort=127.0.0.1:5380:5380/tcp
# DNS
PublishPort=[{{ ansible_all_ipv6_addresses | select('match', '^fd74:6a6f:3030.*') | first }}]:53:53/tcp
PublishPort=[{{ ansible_all_ipv6_addresses | select('match', '^fd74:6a6f:3030.*') | first }}]:53:53/udp
Volume=/srv/data/technitium-dns:/etc/dns:rw

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
